components:
  schemas:
    CourseCreateUpdateDTO:
      required:
      - name
      type: object
      properties:
        name:
          maxLength: 35
          minLength: 1
          pattern: \S
          type: string
    CourseDTO:
      required:
      - name
      - students
      type: object
      properties:
        id:
          format: int64
          type: integer
        name:
          maxLength: 35
          minLength: 1
          pattern: \S
          type: string
        students:
          type: array
          items:
            $ref: "#/components/schemas/StudentDTO"
    StudentCreateUpdateDTO:
      required:
      - firstName
      - lastName
      - email
      type: object
      properties:
        firstName:
          maxLength: 20
          minLength: 1
          pattern: \S
          type: string
        lastName:
          maxLength: 20
          minLength: 1
          pattern: \S
          type: string
        email:
          pattern: \S
          type: string
    StudentDTO:
      required:
      - firstName
      - lastName
      - email
      type: object
      properties:
        id:
          format: int64
          type: integer
        firstName:
          type: string
        lastName:
          type: string
        email:
          type: string
